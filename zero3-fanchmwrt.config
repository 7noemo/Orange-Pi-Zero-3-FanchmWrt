# Orange Pi Zero 3 (Allwinner H618, Cortex-A53) - FanchmWrt build seed
# Base: fanchmwrt/fanchmwrt branch fanchmwrt-25.12.6 (OpenWrt 25.12.6, kernel 6.12)
#
# NOTE: FanchmWrt 的 include/target.mk 里 DEVICE_TYPE 默认 router，
# DEFAULT_PACKAGES.router 已经带了整套 fwx 业务（fwxd / kmod-fwx / 全部
# luci-app-fwx-*）、dnsmasq-full、firewall4、nftables、upnp、ddns、wol、
# autoreboot、block-mount、usb-storage、ext4/vfat、wireguard、ipset、
# nft-tproxy、fullcone、shortcut-fe、ksmbd。这里只补 Wi-Fi、中文、常用插件。

CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
CONFIG_TARGET_sunxi_cortexa53_DEVICE_xunlong_orangepi-zero3=y

# --- 分区大小 ---
# 默认 rootfs 太小（fwx + sqlite + docker + 插件装不下），SD 启动分区留 256M
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_SUNXI_SD_BOOT_PARTSIZE=256

# --- Wi-Fi: 板载 AW859A / UWE5622 ---
# 驱动与固件由 diy-part1.sh 提供（OpenWrt 官方树没有 uwe5622），
# 设备树节点由 patches/102-*.patch 打开（mmc1 + pwrseq + 两路 regulator）
CONFIG_PACKAGE_kmod-uwe5622=y
CONFIG_PACKAGE_uwe5622-firmware=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_iwinfo=y

# --- 中文界面 ---
# luci-i18n-* 是 hidden 包，必须用 LUCI_LANG 开关才会被父包拉进来
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# --- fwx 应用中心（插件商店，默认包里没带）---
CONFIG_PACKAGE_luci-app-fwx-app-center=y

# --- 常用插件 ---
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_tailscale=y

# docker 在 25.12 上需要这两个内核选项，否则 kmod-ipt-physdev / kmod-nf-ipvs
# 无法编译（dockerd 的硬依赖）
CONFIG_KERNEL_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_KERNEL_IP_VS=y

# --- 常用工具 / 外设 ---
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

# --- 科学上网: PassWall2（仅 Xray 芯核 + nftables 透明代理，省 20M+）---
# 来自 kenzok8/small feed（luci-app-passwall2 连同 tcping / geoview 一起）
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All is not set
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin is not set
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
